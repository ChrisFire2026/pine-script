        alert(alertMessage, alert_freq)
    if debugCondition and PC_DEBUG_CT
        PC_DEBUG_LABEL_CT := label.new(bar_index, high + (getPipSize() * 10), alertMessage, color=color.gray, textcolor= color.white, style=label.style_label_lower_right)
        label.delete(PC_DEBUG_LABEL_CT[1])

// Update trade entry price to match TradingView strategy tester 
if strategy.position_size != 0
    if tradeEntrySize != strategy.position_avg_price
        tradeEntrySize := strategy.position_avg_price

// | 🟢 Long Strategy Management Code 🟢 
if strategy.position_size > 0
    if not na(TradeBreakEvenPrice) and high >= TradeBreakEvenPrice and tradeStop < tradeEntrySize
        tradeStop := tradeEntrySize + (PC_BREAK_EVEN_OFFSET * getPipSize())
        TradeBreakEvenPrice := na

    if i_TrailStop > 0 and high >= TrailStopActivatePrice
        TrailStopActivated := true

    if high >= tradeEntrySize
        if UseExitReason
            searchForEXIT := true
        if pending_long and strategy.position_size == 0 and time > pending_gtd_time_long
            strategy.cancel("Buy")
            if strategy.position_size > 0
                pending_long := false
            string alertMessage = PC_ID + ",cancellong," + PC_VAR_SYMBOL + PC_VAR_ACCFILTER + PC_VAR_STRATEGY + PC_VAR_SECRUITY
            if PC_USED
                alert(alertMessage, alert_freq)
            if PC_DEBUG_CCT
                PC_DEBUG_LABEL_CT := label.new(bar_index, high + (getPipSize() * 10), alertMessage, color=color.green, style=label.style_label_lower_right)
                label.delete(PC_DEBUG_LABEL_CT[1])

    if barstate.isconfirmed
        bool ExitTrade = false
        if searchForEXIT
            if i_Exit_HCLC and close < low[1]
                ExitTrade := true
            if i_Exit_Exhaust and close < open
                ExitTrade := true
            if i_RSI_Exhaust and rsiBuyExitSignal 
                ExitTrade := true
            bearishEngulfing = close < open and open[1] < close[1] and close < open[1] and open > close[1]
            stTrendReversalBearish = sttrend[1] == 1 and sttrend == -1
            if i_Reversal_Exit and (stTrendReversalBearish or bearishEngulfing)
                ExitTrade := true
            if i_maCross_Exit and longMAExit
                ExitTrade := true

        if ExitTrade
            strategy.close("Buy", comment= "Long Trade Exit Reason hit")
            string alertMessage = PC_ID + ",closelong," + PC_VAR_SYMBOL + PC_VAR_ACCFILTER + PC_VAR_STRATEGY + PC_VAR_SECRUITY
            if PC_USED
                alert(alertMessage, alert_freq)
            if PC_DEBUG_CT
                PC_DEBUG_LABEL_CT := label.new(bar_index, high + (getPipSize() * 10), alertMessage, color=color.green, style=label.style_label_lower_right)
                label.delete(PC_DEBUG_LABEL_CT[1])

        if TrailStopActivated 
            StopDistancePips = math.abs(close - tradeStop)
            profitProgress = (close - tradeEntrySize) / StopDistancePips
            dynamicMult = math.max(1.5, 2.5 - profitProgress * 0.8)
            chandelierStop = high - (ATR_Value * dynamicMult)
            tradeStop := math.max(tradeStop, chandelierStop)
            NEW_SL = PC_USE_PIP_TARGET ? math.abs(tradeStop - close) / getPipSize() : tradeStop
            string alertMessage = PC_ID + ",newsltpbuy" + orderType + "," + PC_VAR_SYMBOL + ",sl=" + str.tostring(NEW_SL) + PC_VAR_ACCFILTER + PC_VAR_STRATEGY + PC_VAR_SECRUITY
            if PC_USED
                alert(alertMessage, alert_freq)
