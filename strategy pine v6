if strategy.position_size < 0
    if not na(TradeBreakEvenPrice) and low <= TradeBreakEvenPrice and tradeStop > tradeEntrySize
        tradeStop := tradeEntrySize - (PC_BREAK_EVEN_OFFSET * getPipSize())
        TradeBreakEvenPrice := na

    if i_TrailStop > 0 and low <= TrailStopActivatePrice
        TrailStopActivated := true

    if low <= tradeEntrySize
        if UseExitReason
            searchForEXIT := true
        if pending_short and strategy.position_size == 0 and time > pending_gtd_time_short
            strategy.cancel("Sell")
            if strategy.position_size < 0
                pending_short := false
            string alertMessage = PC_ID + ",cancelshort," + PC_VAR_SYMBOL + PC_VAR_ACCFILTER + PC_VAR_STRATEGY + PC_VAR_SECRUITY
