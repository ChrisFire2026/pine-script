// Get market point -> pip value
getPipSize(int multiplier = 1) => 
    float _return = syminfo.mintick * ((multiplier == 1 and (syminfo.type == "forex" or syminfo.type == "crypto" or syminfo.type == "cfd")) ? 10 : multiplier)

unitsToLots(float units) =>
    float lots = units / 100000
    lots := math.round(lots, 2)
    _return = lots * 100000

getDecimals() => 
    float _return = math.abs(math.log(syminfo.mintick) / math.log(10))

getClose(string sym, string tf) =>
    request.security(sym, tf, close[barstate.isrealtime ? 1 : 0], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)[barstate.isrealtime ? 0 : 1]

getUsdPer(string ccy, string tf) =>
    float v = na
    if (ccy == "USD" or ccy == "USDT" or ccy == "USDC" or ccy == "BUSD" or ccy == "FDUSD" or ccy == "DAI")
        v := 1.0
    if (na(v))
        v := getClose(ccy + "USD", tf)
    if (na(v))
        float inv = getClose("USD" + ccy, tf)
        if not na(inv) and inv != 0
            v := 1.0 / inv
    if (na(v))
        v := getClose("COINBASE:" + ccy + "USD", tf)
    if (na(v))
        v := getClose("BINANCE:" + ccy + "USDT", tf)
    v

getQtyStep(bool isFx, float qtyStepOverride) =>
    if not na(qtyStepOverride) and qtyStepOverride > 0
        qtyStepOverride
    else
        float mc = syminfo.mincontract
        if isFx
            (not na(mc) and mc > 1) ? mc : 1000.0
        else
            (not na(mc) and mc > 0) ? mc :
                 math.pow(10.0, -float(math.max(0, math.min(int(math.round(getDecimals())), 8))))

getFxPositionSize(
     float risk, float stopDelta,
     float balance = -1, float fxRate = -1,
     string symbolOverride = "", bool useCurrentTF = false,
     float qtyStep = na,
     string quoteToUsdSym = "", bool debug = false
 ) =>
    string tf = useCurrentTF ? timeframe.period : "D"
    float bal        = balance == -1 ? strategy.equity : balance
    float riskAcct   = bal * (risk / 100.0)
    float pipSize    = math.max(getPipSize(), syminfo.mintick)
    float stopPx     = math.round(math.abs(stopDelta) / syminfo.mintick) * syminfo.mintick
    float stopPips   = stopPx / pipSize
    float conv = 1.0
    string route = "same-ccy"
    if strategy.account_currency != syminfo.currency
        if fxRate != -1
            conv := fxRate
            route := "override-rate"
        else
            if symbolOverride != ""
                float ov = getClose(symbolOverride, tf)
                if not na(ov)
                    conv := ov
                    route := "override-symbol"
            if route == "same-ccy" and syminfo.type == "forex"
                string a2q = strategy.account_currency + syminfo.currency
                float r1 = getClose(a2q, tf)
                if not na(r1)
                    conv := r1
                    route := "forex-direct"
                else
                    string q2a = syminfo.currency + strategy.account_currency
                    float r2 = getClose(q2a, tf)
                    if not na(r2) and r2 != 0
                        conv := 1.0 / r2
                        route := "forex-inverse"
            if route == "same-ccy"
                float usdPerQuote = na
                if quoteToUsdSym != ""
                    usdPerQuote := getClose(quoteToUsdSym, tf)
                if na(usdPerQuote)
                    usdPerQuote := getUsdPer(syminfo.currency, tf)
                float usdPerAcct = getUsdPer(strategy.account_currency, tf)
                if not na(usdPerQuote) and not na(usdPerAcct) and usdPerQuote != 0
                    conv := usdPerAcct / usdPerQuote
                    route := "usd-bridge"
    conv := na(conv) or conv <= 0 ? 1.0 : math.abs(conv)
    bool isFx = (syminfo.type == "forex")
    float rawQty = na
    float qty = na
    float step = na
    string stepPolicy = isFx ? "fx-micro-or-broker" : "nonfx-mincontract/dec"
    if isFx
        float pipPerLotQuote    = pipSize * 100000.0
        float pipPerLotAccount  = strategy.account_currency != syminfo.currency ? (pipPerLotQuote / conv) : pipPerLotQuote
        float perUnitRiskAcct   = stopPips * (pipPerLotAccount / 100000.0)
        perUnitRiskAcct := na(perUnitRiskAcct) or perUnitRiskAcct <= 0 ? na : perUnitRiskAcct
        float rawUnits = na(perUnitRiskAcct) ? na : (riskAcct / perUnitRiskAcct)
        rawQty := rawUnits
        float baseStep = getQtyStep(true, qtyStep)
        bool hasOverride   = not na(qtyStep) and qtyStep > 0
        bool hasBrokerStep = not na(syminfo.mincontract) and syminfo.mincontract > 1
        int  dec           = int(math.round(getDecimals()))
        bool jpyContext    = (syminfo.currency == "JPY") or (strategy.account_currency == "JPY") or (dec <= 3)
        step := baseStep
        if not hasOverride and not hasBrokerStep and jpyContext and not na(rawUnits)
            if rawUnits < baseStep
                if rawUnits >= 100
                    step := 100.0
                    stepPolicy := "fx-jpy-100"
                else
                    step := 1.0
                    stepPolicy := "fx-jpy-1"
            else
                stepPolicy := "fx-jpy-micro"
        else
            stepPolicy := (hasOverride ? "fx-override" : (hasBrokerStep ? "fx-broker-mincontract" : "fx-micro"))
        qty := na(rawUnits) ? 0.0 : (math.floor(rawUnits / step) * step)
    else
        float pv = math.max(math.abs(syminfo.pointvalue), 1e-16)
        float lossPerContractQuote = stopPx * pv
        float lossPerContractAcct  = strategy.account_currency != syminfo.currency ? (lossPerContractQuote / conv) : lossPerContractQuote
        lossPerContractAcct := na(lossPerContractAcct) or lossPerContractAcct <= 0 ? na : lossPerContractAcct
        float rawContracts = na(lossPerContractAcct) ? na : (riskAcct / lossPerContractAcct)
        rawQty := rawContracts
        step := getQtyStep(false, qtyStep)
        qty  := na(rawContracts) ? 0.0 : (math.floor(rawContracts / step) * step)
    if na(qty) or qty <= 0
        qty := 0.0
    if debug
        log.info("Sizing (" + syminfo.type + "|" + route + "|" + (isFx ? "fx-units" : "pv-contract") + "): " +
                 "bal=" + str.tostring(bal) +
                 " risk=" + str.tostring(riskAcct, "#.####") +
                 " | pipSize=" + str.tostring(pipSize, "#.#####") +
                 " | stopPx=" + str.tostring(stopPx, "#.#####") +
                 " | stopPips=" + str.tostring(stopPips, "#.###") +
                 " | conv=" + str.tostring(conv, "#.#####") +
                 " | step=" + str.tostring(step) +
                 " | stepPolicy=" + stepPolicy +
                 " | rawQty=" + str.tostring(rawQty, "#.######") +
                 " | qty=" + str.tostring(qty, "#.######") +
                 " | acct=" + strategy.account_currency + " quote=" + syminfo.currency)
    qty

