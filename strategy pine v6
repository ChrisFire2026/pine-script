    performance_table.cell(13, 0, "TOTAL", bgcolor=mptable_titleColor, text_color=mptable_titleTextColor, text_size=tableTextSize)
    performance_table.cell(14, 0, "MaxDD", bgcolor=mptable_titleColor, text_color=mptable_titleTextColor, text_size=tableTextSize)

    for year_index = startIndex to yearlyReturns.size() == 0 ? na : endIndex
        StrategyReturn yearlyReturn = yearlyReturns.get(year_index)
        performance_table.cell(0, year_index + 1, str.tostring(year(yearlyReturn.timestamp)), bgcolor=mptable_titleColor, text_color=mptable_titleTextColor, text_size=tableTextSize)
        color y_color = yearlyReturn.profit > 0 ? mptable_ProfitColor : yearlyReturn.profit == 0 ? mptable_BreakEvenColor : mptable_LossColor
        string yearlyTip = "MaxDD: " + str.tostring(math.round(yearlyReturn.drawdown, GetRoundingPrecision(yearlyReturn.drawdown))) + "%" +
             "\nMFE: " + str.tostring(math.round(yearlyReturn.peak, GetRoundingPrecision(yearlyReturn.peak))) + "%"
        performance_table.cell(13, year_index + 1, (yearlyReturn.profit > 0 ? "+" : "") + str.tostring(math.round(yearlyReturn.profit, GetRoundingPrecision(yearlyReturn.profit))) + "%", bgcolor=y_color, text_color=color.white, text_size=tableTextSize, tooltip=yearlyTip)
        performance_table.cell(14, year_index + 1, str.tostring(math.round(yearlyReturn.drawdown, GetRoundingPrecision(yearlyReturn.drawdown))) + "%", bgcolor=mptable_BreakEvenColor, text_color=color.white, text_size=tableTextSize)

        for month_index = 0 to monthlyReturns.size() - 1
            StrategyReturn monthlyReturn = monthlyReturns.get(month_index)
            int yearOfMonth = year(monthlyReturn.timestamp)
            int monthCol    = month(monthlyReturn.timestamp)
            if yearOfMonth == year(yearlyReturn.timestamp)
                color m_color = monthlyReturn.profit > 0 ? color.new(mptable_ProfitColor, color.t(mptable_ProfitColor) + 20) : monthlyReturn.profit == 0 ? color.new(mptable_BreakEvenColor, color.t(mptable_BreakEvenColor) + 20) : color.new(mptable_LossColor, color.t(mptable_LossColor) + 20)
                string monthlyTip = "MaxDD: " + str.tostring(math.round(monthlyReturn.drawdown, GetRoundingPrecision(monthlyReturn.drawdown))) + "%" +
                     "\nMFE: " + str.tostring(math.round(monthlyReturn.peak, GetRoundingPrecision(monthlyReturn.peak))) + "%"
                performance_table.cell(monthCol, year_index + 1, str.tostring(math.round(monthlyReturn.profit, GetRoundingPrecision(monthlyReturn.profit))), bgcolor=m_color, text_color=color.white, text_size=tableTextSize, tooltip=monthlyTip)

    float start_time   = strategy.closedtrades.entry_time(0)
    float end_time     = strategy.closedtrades.exit_time(strategy.closedtrades - 1)
    float time_diff    = end_time - start_time
    float years_traded = na(time_diff) or time_diff == 0 ? na : time_diff / 31536000000.0
    float final_value  = strategy.netprofit + strategy.initial_capital
    float cagr         = na(years_traded) or years_traded == 0 ? na : (math.pow(final_value / strategy.initial_capital, 1 / years_traded) - 1) * 100
    float percentReturn = (strategy.netprofit / strategy.initial_capital) * 100
    float mar = cagr / math.abs(worstDrawdown)
    lastMonthRowIndex = startIndex < 5 ? 5 : startIndex

    float totalWinRate  = (strategy.wintrades / strategy.closedtrades) * 100
    float longWinRate   = nz((totalLongTradeWins / totalLongTrades) * 100)
    float shortWinRate  = nz((totalShortTradeWins / totalShortTrades) * 100)
    int avgTradesYr     = math.ceil(strategy.closedtrades / years_traded)
    float totalCommissionCost = 0
    for i = 0 to strategy.closedtrades
        totalCommissionCost := totalCommissionCost + strategy.closedtrades.commission(i)
    float commissionDrag = ((totalCommissionCost / strategy.initial_capital) * 100) / years_traded
    string returnTip = "Based on a total of " + str.tostring(strategy.closedtrades) + " trades" +
         "\nWin Rate = " + str.tostring(math.round(totalWinRate, GetRoundingPrecision(totalWinRate))) + "%" +
         "\nLong Trades = " + str.tostring(totalLongTrades) + " (Win " + str.tostring(math.round(longWinRate, GetRoundingPrecision(longWinRate))) + "%)" +
         "\nShort Trades = " + str.tostring(totalShortTrades) + " (Win " + str.tostring(math.round(shortWinRate, GetRoundingPrecision(shortWinRate))) + "%)" +
         "\nAvg Trades Per Year = " + str.tostring(avgTradesYr) + " (" + str.tostring(years_traded, "#.#") + " years)" +
         "\nCommission Drag = " + str.tostring(commissionDrag, "#.##") + "% per year"
    performance_table.cell(15, lastMonthRowIndex,     "Return: " + (percentReturn > 0 ? "+" : "") + str.tostring(math.round(percentReturn, GetRoundingPrecision(percentReturn))) + "%", bgcolor=mptable_titleColor, text_color=mptable_titleTextColor, text_font_family=font.family_monospace, text_size=tableTextSize, tooltip=returnTip)
    performance_table.cell(15, lastMonthRowIndex - 1, "MAR: " + str.tostring(mar, "#.##"), bgcolor=mptable_titleColor, text_color=mptable_titleTextColor, text_font_family=font.family_monospace, text_size=tableTextSize, tooltip="Measure of return adjusted for risk: CAGR / Max Drawdown. Higher than 0.5 is ideal, 1.0+ is very good.")
    performance_table.cell(15, lastMonthRowIndex - 2, "DD Bars: " + str.tostring(maxDrawdownBars), bgcolor=mptable_titleColor, text_color=mptable_titleTextColor, text_font_family=font.family_monospace, text_size=tableTextSize, tooltip="Average Drawdown Bars: " + str.tostring(totalDrawdownBars.avg(), "#.#"))
    performance_table.cell(15, lastMonthRowIndex - 3, "MaxDD: " + str.tostring(math.round(worstDrawdown, GetRoundingPrecision(worstDrawdown))) + "%", bgcolor=mptable_titleColor, text_color=mptable_titleTextColor, text_font_family=font.family_monospace, text_size=tableTextSize, tooltip="Average Drawdown: " + str.tostring(totalDrawdowns.avg(), "#.##") + "%")
    performance_table.cell(15, lastMonthRowIndex - 4, "CAGR: " + (cagr > 0 ? "+" : "") + str.tostring(math.round(cagr, GetRoundingPrecision(cagr))) + "%", bgcolor=mptable_titleColor, text_color=mptable_titleTextColor, text_font_family=font.family_monospace, text_size=tableTextSize, tooltip="Compounded annual growth rate")
    performance_table.cell(15, lastMonthRowIndex - 5, "REALIZED P&L", bgcolor=mptable_titleColor, text_color=mptable_titleTextColor, text_font_family=font.family_monospace, text_size=tableTextSize, tooltip="These numbers are based on Realized equity (closed trades)")

// Debug plots
plot(na, title="##### PERFORMANCE DEBUG #####", display=display.data_window)
plot(lastTradeCost, title="Last Trade Cost $", display=display.data_window)
plot(lastProfitLoss, title="Last Trade P&L $", display=display.data_window)
plot(lastCumulativeProfitPercent, title="Last Trade P&L %", display=display.data_window)
plot(accumulatedMonthlyPL, title="Accum. Monthly P&L", display=display.data_window)
plot(accumulatedYearlyPL, title="Accum. Yearly P&L", display=display.data_window)

// Stats tables
var table testTable    = table.new(position.top_right,    5, 4, border_color=color.aqua,    border_width=2, frame_color=color.aqua,    frame_width=3)
var table BKtesterTable = table.new(position.bottom_right, 5, 4, border_color=color.fuchsia, border_width=2, frame_color=color.fuchsia, frame_width=3)

zenfillCell(_table, _column, _row, _title, _value, _bgcolor, _txtcolor, _toolTip) =>
    _cellText = _title + "\n" + _value
    table.cell(_table, _column, _row, _cellText, bgcolor=_bgcolor, text_color=_txtcolor, text_size=size.small)

var bgcolor = color.new(color.black, 0)
if drawTester
    newWin  = (strategy.wintrades  > strategy.wintrades[1])  and (strategy.losstrades == strategy.losstrades[1]) and (strategy.eventrades == strategy.eventrades[1])
    newLoss = (strategy.wintrades == strategy.wintrades[1])   and (strategy.losstrades  > strategy.losstrades[1]) and (strategy.eventrades == strategy.eventrades[1])

    varip int winRow     = 0
    varip int lossRow    = 0
    varip int maxWinRow  = 0
    varip int maxLossRow = 0

    if newWin
        lossRow := 0
        winRow  := winRow + 1
    if winRow > maxWinRow
        maxWinRow := winRow
    if newLoss
        winRow  := 0
        lossRow := lossRow + 1
    if lossRow > maxLossRow
        maxLossRow := lossRow

    if barstate.islastconfirmedhistory
        float totalNonBETrades = totalTrades - totalBreakEvenTrades
        string winRateTooltip = ""
        string lossRateTooltip = ""

        if winRateCalculation == "Include BE"
            _totalWinRate       := (strategy.wintrades / strategy.closedtrades) * 100
            winTradePercentage  := totalTrades > 0 ? (totalWinTrades / totalTrades) * 100 : 0.0
            lossTradePercentage := totalTrades > 0 ? (totalLossTrades / totalTrades) * 100 : 0.0
            winRateTooltip      := "Win Rate: " + str.tostring(totalWinTrades) + " wins / " + str.tostring(totalTrades) + " total trades"
            lossRateTooltip     := "Loss Rate: " + str.tostring(totalLossTrades) + " losses / " + str.tostring(totalTrades) + " total trades"
        else if winRateCalculation == "Exclude BE"
            _totalWinRate       := (strategy.wintrades / (strategy.closedtrades - totalBreakEvenTrades)) * 100
            winTradePercentage  := totalNonBETrades > 0 ? (totalWinTrades / totalNonBETrades) * 100 : 0.0
            lossTradePercentage := totalNonBETrades > 0 ? (totalLossTrades / totalNonBETrades) * 100 : 0.0
            winRateTooltip      := "Win Rate: " + str.tostring(totalWinTrades) + " wins / " + str.tostring(totalNonBETrades) + " non-BE trades"
            lossRateTooltip     := "Loss Rate: " + str.tostring(totalLossTrades) + " losses / " + str.tostring(totalNonBETrades) + " non-BE trades"
        else if winRateCalculation == "Count BE as Win"
            _totalWinRate       := ((strategy.wintrades + totalBreakEvenTrades) / strategy.closedtrades) * 100
            winTradePercentage  := totalTrades > 0 ? ((totalWinTrades + totalBreakEvenTrades) / totalTrades) * 100 : 0.0
            lossTradePercentage := totalTrades > 0 ? (totalLossTrades / totalTrades) * 100 : 0.0
            winRateTooltip      := "Win Rate: (" + str.tostring(totalWinTrades) + " wins + " + str.tostring(totalBreakEvenTrades) + " BE) / " + str.tostring(totalTrades) + " total trades"
            lossRateTooltip     := "Loss Rate: " + str.tostring(totalLossTrades) + " losses / " + str.tostring(totalTrades) + " total trades"

        string winRateTip = "Win Rate Calculation: " + winRateCalculation +
             "\nTotal Trades: " + str.tostring(strategy.closedtrades) +
             "\nWinning Trades: " + str.tostring(strategy.wintrades) +
             "\nWinning Trades %: " + str.tostring(winTradePercentage, "##.##") + "%" +
             "\nBreak Even Trades: " + str.tostring(totalBreakEvenTrades) +
             "\nLosing Trades: " + str.tostring(strategy.losstrades) +
             "\nLosing Trades %: " + str.tostring(lossTradePercentage, "##.##") + "%"
        label.new(bar_index, high + (high * 0.001), "Win Rate Calculation: " + str.tostring(math.round(_totalWinRate)) + "%", text_formatting= text.format_bold + text.format_italic, tooltip= winRateTip, style=label.style_label_lower_left, textcolor=color.white)

        string timeInDrawdown = "Timeframe Unsupported"
        string avgDrawdown    = "Timeframe Unsupported"
        if (timeframe.isdwm)
            if (timeframe.isdaily)
                timeInDrawdown := str.tostring(drawdownBarsArray.max() * timeframe.multiplier) + " days"
                avgDrawdown    := str.tostring(averageBarsInDD * timeframe.multiplier, "#.##") + " days"
            else
                testTable.cell(0, 0, "Timeframe Unsupported")
        else
            int minutesInDrawdown = drawdownBarsArray.max() * int(str.tonumber(timeframe.period))
            if (minutesInDrawdown <= 60)
                timeInDrawdown := str.tostring(minutesInDrawdown) + " minutes"
                avgDrawdown    := str.tostring(averageBarsInDD * str.tonumber(timeframe.period), "#.##") + " minutes"
            else if (minutesInDrawdown <= 1440)
                timeInDrawdown := str.tostring(minutesInDrawdown / 60, "#.##") + " hours"
                avgDrawdown    := str.tostring((averageBarsInDD * str.tonumber(timeframe.period)) / 60, "#.##") + " hours"
            else
                timeInDrawdown := str.tostring(minutesInDrawdown / 1440, "#.##") + " days"
                avgDrawdown    := str.tostring((averageBarsInDD * str.tonumber(timeframe.period)) / 1440, "#.##") + " days"

        var float totalProfit = 0.0
        if strategy.closedtrades > 0
            totalProfit := strategy.netprofit

        float _profit = (strategy.netprofit / strategy.initial_capital) * 100
        float _numOfDaysInStrategy = (strategy.opentrades.size(strategy.opentrades) > 0 and strategy.closedtrades > 0) ? (strategy.opentrades.entry_time(0) - strategy.closedtrades.entry_time(0)) / (1440 * 60 * 1000 * 24) : na
        float cagr = (yearlyReturns.size() > 0) ? (math.pow((strategy.netprofit + strategy.initial_capital) / strategy.initial_capital, 1 / yearlyReturns.size()) - 1) * 100 : na
        float mar  = (not na(cagr) and math.abs(worstDrawdown) != 0) ? cagr / math.abs(worstDrawdown) : na

        if totalTradeStatic
            zenfillCell(testTable, 0, 0, "Total Trades:", str.tostring(strategy.closedtrades) + " [*" + str.tostring(questionableTrades) + "]", bgcolor, color.white, _toolTip= "na")
            zenfillCell(testTable, 0, 1, "Max Runup:",    str.tostring(zen.truncate(strategy.max_runup, 2)), bgcolor, color.white, _toolTip= "na")
            zenfillCell(testTable, 0, 2, "breakEven:",    str.tostring(totalBreakEvenTrades), bgcolor, color.white, _toolTip= winRateTip)
            zenfillCell(testTable, 0, 3, "Pips:",         (totalPips > 0 ? "+" : "") + str.tostring(zen.truncate(zen.toWhole(totalPips),2)), bgcolor, color.white, _toolTip= "na")

        if profitLine
            zenfillCell(testTable, 1, 0, "Win Rate:",     str.tostring(zen.truncate(_totalWinRate)) + "%", _totalWinRate < 50 ? color.red : _totalWinRate < 75 ? #999900 : color.green, color.white, _toolTip= winRateTooltip)
            zenfillCell(testTable, 1, 1, "Avg % Per Day", str.tostring(zen.truncate(_profit / _numOfDaysInStrategy, 5)) + "%", _profit > 0 ? color.green : color.red, color.white, _toolTip= "na")
            zenfillCell(testTable, 1, 2, "Profit Factor:", str.tostring(zen.truncate(strategy.grossprofit / strategy.grossloss, 2)), strategy.grossprofit > strategy.grossloss ? color.green : color.red, color.white, _toolTip= "na")
            zenfillCell(testTable, 1, 3, "Net Profit:",   str.tostring(_profit, '##.##') + "%" + " [$" + str.tostring(zen.truncate(totalProfit, 2)) + "]", _profit > 0 ? color.green : color.red, color.white, _toolTip= "na")

        if averageLine
            zenfillCell(testTable, 2, 0, "Avg Win:",       "$" + str.tostring(zen.truncate(strategy.grossprofit / strategy.wintrades, 2)), bgcolor, color.white, _toolTip= "na")
            zenfillCell(testTable, 2, 1, "Avg Loss:",      "$" + str.tostring(zen.truncate(strategy.grossloss / strategy.losstrades, 2)),  bgcolor, color.white, _toolTip= "na")
            zenfillCell(testTable, 2, 2, "Won trades %:",  str.tostring(winTradePercentage, "##.##") + "%", bgcolor, color.white, _toolTip= "na")
            zenfillCell(testTable, 2, 3, "Loss Trades %:", str.tostring(lossTradePercentage, "##.##") + "%", bgcolor, color.white, _toolTip= "na")

        if tradesWinLossStat
            zenfillCell(testTable, 3, 0, "Won Trades:",     str.tostring(zen.truncate(winRateCalculation == "Count BE as Win" ? strategy.wintrades + totalBreakEvenTrades : strategy.wintrades)), bgcolor, color.white, _toolTip= winRateTooltip)
            zenfillCell(testTable, 3, 1, "Loss Trades:",    str.tostring(zen.truncate(strategy.losstrades)), bgcolor, color.white, _toolTip= lossRateTooltip)
            zenfillCell(testTable, 3, 2, "Max Wins Row:",   str.tostring(maxWinRow, '######'), bgcolor, color.white, _toolTip= "na")
            zenfillCell(testTable, 3, 3, "Max Losses Row:", str.tostring(maxLossRow, '######'), bgcolor, color.white, _toolTip= "na")

        if dDStatic
            zenfillCell(testTable, 4, 0, "Max DD:",          str.tostring(zen.truncate(zen.maxDrawdownRealized(), 2)) + "%", color.red, color.white, _toolTip= "na")
            zenfillCell(testTable, 4, 1, "Avg RR:",          str.tostring(zen.averageRR(), '######'), bgcolor, color.white, _toolTip= "na")
            zenfillCell(testTable, 4, 2, "Worst Drawdown:",  timeInDrawdown, bgcolor, color.white, _toolTip= "na")
            zenfillCell(testTable, 4, 3, "Avg Drawdown:",    avgDrawdown, bgcolor, color.white, _toolTip= "Total Drawdown Count: " + str.tostring(drawdownBarsArray.size()))

if drawStats
    if barstate.islastconfirmedhistory
        float dollarReturn = strategy.equity - strategy.initial_capital
        float dollarReturnPercentage = 0.0
        if strategy.initial_capital > 0
            dollarReturnPercentage := (dollarReturn / strategy.initial_capital) * 100
        else
            dollarReturnPercentage := na

        zenfillCell(BKtesterTable, 0, 0, "Starting:", "$" + str.tostring(strategy.initial_capital), bgcolor, color.white, _toolTip= "na")
        zenfillCell(BKtesterTable, 0, 1, "Ending:",   "$" + str.tostring(zen.truncate(BalanceToDate, 2)), bgcolor, color.white, _toolTip= "na")
        zenfillCell(BKtesterTable, 1, 0, "Return:",   (dollarReturn > 0 ? "+" : "") + str.tostring(zen.truncate(dollarReturnPercentage, 2)) + "%", dollarReturn > 0 ? color.green : color.red, color.white, _toolTip= "na")
        zenfillCell(BKtesterTable, 1, 1, "Return:",   "$" + str.tostring(zen.truncate(dollarReturn, 2)), dollarReturn > 0 ? color.green : color.red, color.white, _toolTip= "na")

/////////// END OF PERFORMANCE TABLE AND TESTER CODE ///////////

if barstate.ishistory
    if bar_index % 100 == 0
        true
else
    varip lastTime = timenow
    varip updateNo = 0
    if barstate.isnew
        updateNo := 0
    else
        updateNo += 1
    lastTime := timenow
