// Helper functions for session validation
toMinutes(timeStr) =>
    if str.length(timeStr) != 4
        runtime.error("Invalid time string: " + timeStr)
    hourStr = str.substring(timeStr, 0, 2)
    minStr = str.substring(timeStr, 2, 4)
    hourVal = str.tonumber(hourStr)  
    minuteVal = str.tonumber(minStr) 
    hourVal * 60 + minuteVal

sessionToIntervals(sessionStr) =>
    parts = str.split(sessionStr, '-')
    if array.size(parts) != 2
        runtime.error("Invalid session format: " + sessionStr)
    startStr = array.get(parts, 0)
    endStr = array.get(parts, 1)
    startMin = toMinutes(startStr)
    endMin = toMinutes(endStr)
    var intervals = array.new<int>()
    if startMin <= endMin
        array.push(intervals, int(startMin))
        array.push(intervals, int(endMin))
    else
        array.push(intervals, int(startMin))
        array.push(intervals, int(1440))
        array.push(intervals, int(0))
        array.push(intervals, int(endMin))
    intervals

sessionsOverlap(sess1, sess2) =>
    intervals1 = sessionToIntervals(sess1)
    intervals2 = sessionToIntervals(sess2)
    bool overlap = false
    for i = 0 to array.size(intervals1) - 1 by 2
        start1 = array.get(intervals1, i)
        end1   = array.get(intervals1, i + 1)
        for j = 0 to array.size(intervals2) - 1 by 2
            start2 = array.get(intervals2, j)
            end2   = array.get(intervals2, j + 1)
            if math.max(start1, start2) < math.min(end1, end2)
                overlap := true
    overlap

