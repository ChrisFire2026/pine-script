            label.delete(PC_DEBUG_LABEL_CT[1])
    else if trading_halted and current_drawdown <= (i_max_dd - i_recovery_threshold)
        trading_halted := false
        allow_trading := true

// --- SUPER TREND CALCULATION --- //
var float sttrend = na
sttr   = math.max((high - low), math.abs(high - close[1]), math.abs(low - close[1]))
statr2 = ta.sma(sttr, stPeriods)
statr  = stChangeATR ? statr2 : ta.rma(sttr, stPeriods)
stup   = stSource - stMultiplier * statr
stup1  = nz(stup[1], stup)
stup   := close[1] > stup1 ? math.max(stup, stup1) : stup
stdn   = stSource + stMultiplier * statr
stdn1  = nz(stdn[1], stdn)
stdn   := close[1] < stdn1 ? math.min(stdn, stdn1) : stdn
CloseST = close
sttrend := 1
sttrend := nz(sttrend[1], sttrend)
sttrend := sttrend == -1 and CloseST > stdn1 ? 1 : sttrend == 1 and CloseST < stup1 ? -1 : sttrend

// --- TRADE EXECUTION LOGIC --- //
superTrendBuy  = sttrend == 1 and sttrend[1] != 1
superTrendSell = sttrend == -1 and sttrend[1] != -1

// Check system filters
EmaFilterLong  = i_ema_filter_Length == 0 or close > EMA_Value and ema_distance_ok
EmaFilterShort = i_ema_filter_Length == 0 or close < EMA_Value and ema_distance_ok
AtrMinFilter   = high - low >= (FILTER_ATR_MIN_SIZE * ATR_Value) or FILTER_ATR_MIN_SIZE == 0.0
AtrMaxFilter   = high - low <= (FILTER_ATR_MAX_SIZE * ATR_Value) or FILTER_ATR_MIN_SIZE == 0.0
AtrFilter      = AtrMinFilter and AtrMaxFilter and not na(ATR_Value)

// Volume conditions
volumeCondition = not i_use_volume_filter or volume > (avgVolume * volumeThresholdMultiplier)

// HTF Confirmation
htf_trend    = request.security(syminfo.tickerid, "240", sttrend, lookahead=barmerge.lookahead_off)
htf_long_ok  = not i_useHTFilter or htf_trend == 1
htf_short_ok = not i_useHTFilter or htf_trend == -1

// Modular Entry Conditions
longEntryCondition() =>
    EmaFilterLong and AtrFilter and volumeCondition and consolidation_ok and adx_ok and htf_long_ok and strongTrend and
     (cleanMode ? (impulseBull and rsiMomentumLong and volSpike) : true)

shortEntryCondition() =>
    EmaFilterShort and AtrFilter and volumeCondition and consolidation_ok and adx_ok and htf_short_ok and strongTrend and
     (cleanMode ? (impulseBear and rsiMomentumShort and volSpike) : true)

// Determine if the market is in a range
