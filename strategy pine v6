finalRangeLong  = isInRange and (rsi < rsiOS * 0.9) and (rsi[1] >= rsiOS) and close > open
finalRangeShort = isInRange and (rsi > rsiOB * 1.1) and (rsi[1] <= rsiOB) and close < open

if barstate.isfirst
