impulseBull = ta.rising(close, impulseLookback) and (close - ta.lowest(low, impulseLookback)) >= minImpulseATR * ATR_Value
impulseBear = ta.falling(close, impulseLookback) and (ta.highest(high, impulseLookback) - close) >= minImpulseATR * ATR_Value

rsiMomentumLong  = ta.rising(smoothed_rsi, 2) and smoothed_rsi > 50 * rsiMomentumMult
rsiMomentumShort = ta.falling(smoothed_rsi, 2) and smoothed_rsi < 50 / rsiMomentumMult

