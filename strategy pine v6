// FIX 4: Consolidation filter corrected — now tracks if price WAS consolidating recently
// (within the last consolidation_bars bars), then clears after a signal fires.
// Original logic required price to STILL be tight at entry, blocking breakout entries.
var consolidationArray = array.new_float(consolidation_bars + 1, 0.0)
is_consolidating = true

array.unshift(consolidationArray, close)
array.pop(consolidationArray)

if bar_index > consolidation_bars
    max_diff = 0.0
    for i = 0 to consolidation_bars - 1
        diff = math.abs(array.get(consolidationArray, i) - array.get(consolidationArray, i + 1))
        max_diff := math.max(max_diff, diff)
    is_consolidating := max_diff <= 0.5 * ATR_Value

// Track if we were recently consolidating — this is what we actually want for breakout entries
if is_consolidating
    recentlyConsolidated := true

// consolidation_ok: passes if filter is off, OR if we were recently in consolidation (proper breakout check)
consolidation_ok = not i_use_consolidation or recentlyConsolidated

