             PC_FREQ == "alert.freq_once_per_bar" ? alert.freq_once_per_bar : 
             alert.freq_once_per_bar_close

// Track peak equity and drawdown
var float peak_equity = strategy.equity
var float worst_drawdown = 0.0
var bool trading_halted = false

peak_equity := math.max(peak_equity, strategy.equity)
float current_drawdown = (peak_equity - strategy.equity) / peak_equity * 100

if current_drawdown > worst_drawdown
    worst_drawdown := current_drawdown

// FIX 5: allow_trading now resets to true every bar when MDD switch is OFF.
// Previously, if MDD switch was disabled after a halt, allow_trading stayed stuck at false
