isForceCloseDay() =>
    dayOfWeek = dayofweek(time, timeZone)
    isCorrectDay = 
         (forceCloseDay == "Monday" and dayOfWeek == dayofweek.monday) or 
         (forceCloseDay == "Tuesday" and dayOfWeek == dayofweek.tuesday) or 
         (forceCloseDay == "Wednesday" and dayOfWeek == dayofweek.wednesday) or 
         (forceCloseDay == "Thursday" and dayOfWeek == dayofweek.thursday) or 
         (forceCloseDay == "Friday" and dayOfWeek == dayofweek.friday) or 
         (forceCloseDay == "Saturday" and dayOfWeek == dayofweek.saturday) or 
         (forceCloseDay == "Sunday" and dayOfWeek == dayofweek.sunday)
    hourForce = hour(forceCloseTime, timeZone)
    minuteForce = minute(forceCloseTime, timeZone)
    forceCloseTimeToday = timestamp(timeZone, year(time), month(time), dayofmonth(time), hourForce, minuteForce, 0)
    barEndTime = time + timeframe.in_seconds() * 1000
    isForceCloseTime = forceCloseTimeToday >= time and forceCloseTimeToday < barEndTime
    forceCloseDay != "Never" and isCorrectDay and isForceCloseTime

